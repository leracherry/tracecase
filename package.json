{
  "name": "tracecase-workspace",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:extension && npm run build:viewer",
    "check": "npm run check:core && npm run check -w @tracecase/extension && npm run check -w @tracecase/viewer",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "node fixtures/demo-store/server.mjs",
    "tracecase": "node dist/cli/src/index.js",
    "schema": "npm run build:core && node scripts/schema.mjs",
    "build:core": "tsc -p tsconfig.json",
    "build:extension": "npm run build -w @tracecase/extension",
    "build:viewer": "npm run build -w @tracecase/viewer",
    "check:core": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "playwright": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrweb": "^2.1.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "wxt": "^0.21.4"
  }
}
